meta {
  name: 2. Book Duplicate Vehicle VIN (Expect 409 Conflict)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/appointments
  body: json
  auth: none
}

body:json {
  {
    "customerId": 2,
    "vehicleVin": "1HGCR2F83HA000001",
    "dealershipId": 1,
    "serviceTypeId": 2,
    "requestedStartTime": "2026-11-20T09:00:00Z"
  }
}

docs {
  Vehicle VIN Conflict Test:
  Customer 2 attempts to book the exact same Vehicle VIN (1HGCR2F83HA000001) that is already
  booked for Customer 1 at 2026-11-20T09:00:00Z.
  The server must reject with HTTP 409 Conflict:
  "Vehicle VIN 1HGCR2F83HA000001 already has an active appointment in this time window."
}
